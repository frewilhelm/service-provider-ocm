{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Only open/update PRs on Sundays to batch dependency noise to one day per week.
  schedule: ['on sunday'],

  extends: [
    'config:recommended',
    'config:best-practices',
    'security:openssf-scorecard',
    'helpers:pinGitHubActionDigests',
    ':rebaseStalePrs',
    ':dependencyDashboard',
  ],
  'git-submodules': {
    enabled: true,
  },

  // Ignore workflow files inside the hack/common submodule — they are
  // managed by openmcp-project/build and cannot be modified from this repo.
  ignorePaths: [
    'hack/common/**',
  ],

  // Bake-time before a release is considered: avoids chasing yanked or
  // quickly-patched releases. Security alerts bypass this gate (see below).
  minimumReleaseAge: '7 days',

  branchPrefix: 'renovate/',
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Auto-merge everything by default once CI + branch protection pass.
  // Major updates open PRs but stay manual-merge (packageRule below).
  automerge: true,
  automergeType: 'pr',

  // Security fixes bypass the release-age bake time but still require a human
  // merge — they must never auto-merge.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: false,
  },

  // Create separate PRs for minor vs. patch bumps so they can be reviewed and
  // merged independently (e.g. a patch security fix is not blocked by a minor
  // feature update).
  separateMinorPatch: true,

  packageRules: [
    // ── Major updates ────────────────────────────────────────────────────
    // Majors may contain breaking changes: open a PR so they are visible in
    // the PR list, but never auto-merge — they get reviewed and merged by hand.
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
    },

    // ── Go module hygiene ────────────────────────────────────────────────
    // Run `go mod tidy` after every Go dependency update to keep go.sum
    // consistent and avoid noisy follow-up commits.
    {
      matchCategories: [
        'golang',
      ],
      postUpdateOptions: [
        'gomodTidy',
      ],
    },

    // ── Suppress Docker digest-only churn ────────────────────────────────
    // Digest-only bumps for Docker images create noise without a meaningful
    // version change. Disable them; tagged version bumps still come through.
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      enabled: false,
    },


    // ── Dependency grouping ──────────────────────────────────────────────
    // Group related dependencies into a single PR to reduce review overhead
    // and ensure co-dependent packages stay in sync.

    // Kubernetes client libraries (k8s.io, sigs.k8s.io) are tightly coupled
    // and should always be updated together to avoid version skew.
    {
      groupName: 'Kubernetes Go modules',
      matchPackageNames: [
        'k8s.io/{/,}**',
        'sigs.k8s.io/{/,}**',
      ],
    },

    // OCM libraries often share release cycles; grouping them prevents
    // partial upgrades that could break cross-module compatibility.
    {
      groupName: 'OCM Go modules',
      matchPackageNames: [
        'github.com/open-component-model/{/,}**',
      ],
    },

    // GitHub Actions are pinned to digests (via helpers:pinGitHubActionDigests).
    // Grouping their updates into one PR keeps CI pipeline changes atomic
    // and easy to review.
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'GitHub Actions',
    },

    // All remaining Go modules not matched by a more-specific rule above go
    // into one PR so stray transitive bumps don't create individual noise PRs.
    {
      groupName: 'Go modules',
      matchCategories: [
        'golang',
      ],
    },

    // Docker/OCI images that are not already handled by a specific rule go
    // into one PR, keeping image-digest churn consolidated.
    {
      groupName: 'Docker images',
      matchDatasources: [
        'docker',
      ],
    },
  ],

  customManagers: [
    // ── OCM K8s Toolkit Helm chart tracking ──────────────────────────────
    // Track new stable releases of the OCM K8s Toolkit Helm chart in GHCR.
    // Matches files annotated with "# renovate: datasource=docker depName=...".
    // Uses semver versioning so pre-release tags (RC, alpha, beta) are ignored.
    {
      description: 'OCM K8s Toolkit chart version',
      customType: 'regex',
      managerFilePatterns: [
        '/test/e2e/onboarding/ocm\\.yaml/',
        '/test/e2e/platform/providerconfig\\.yaml/',
        '/README\\.md/',
      ],
      matchStrings: [
        // `version:` or `- version:`, optional quotes, optional `v` prefix.
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+-?\\s*version:\\s+"?v?(?<currentValue>[^"\\s]+)"?',
        // `chartVersion:` line under the same renovate comment.
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+-?\\s*version:[^\\n]*\\n\\s+chartVersion:\\s+"?(?<currentValue>[^"\\s]+)"?',
      ],
      versioningTemplate: 'semver',
    },

    // ── E2E test infrastructure images ───────────────────────────────────
    // Track openmcp-operator and cluster-provider-kind image versions used
    // in e2e tests. Matches Go string literals annotated with the standard
    // "// renovate: datasource=docker depName=..." comment.
    {
      description: 'E2E test infrastructure images',
      customType: 'regex',
      managerFilePatterns: [
        '/test/e2e/main_test\\.go/',
      ],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+Image:\\s+"[^:]+:(?<currentValue>[^"]+)"',
      ],
      versioningTemplate: 'semver',
    },
  ],
}
